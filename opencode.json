{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "uv": "allow",
      "uv *": "allow",
      "pytest": "allow",
      "pytest *": "allow",
      "ruff": "allow",
      "ruff *": "allow",
      "pyright": "allow",
      "pyright *": "allow",
      "python": "allow",
      "python *": "allow",
      "python3": "allow",
      "python3 *": "allow",
      "sudo": "deny",
      "sudo *": "deny",
      "/usr/bin/sudo": "deny",
      "/usr/bin/sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "/bin/su": "deny",
      "/bin/su *": "deny",
      "rm -rf /": "deny",
      "rm -fr /": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "rm -R *": "deny",
      "rmdir *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git pull": "deny",
      "git pull *": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git cherry-pick": "deny",
      "git cherry-pick *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "git worktree": "deny",
      "git worktree *": "deny",
      "git remote": "deny",
      "git remote *": "deny",
      "git config": "deny",
      "git config *": "deny",
      "git switch": "deny",
      "git switch *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git -C *": "deny",
      "git commit --amend": "deny",
      "git commit --amend *": "deny",
      "git branch -f main *": "deny",
